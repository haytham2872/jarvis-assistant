# --- Secrets & credentials — NEVER commit ---------------------------------
# SearXNG settings, generated by setup with their own secret_key
searxng/settings.yml
.env
token.json
token_calendar.json
spotify_token.json
spotify_credentials.json
*.key
*.pem

# --- Python ----------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Frontend --------------------------------------------------------------
frontend/node_modules/
frontend/dist/

# --- Local data & operational state (machine-specific, rebuilt on each host)
backups/
logs/
.self_model_cache.json
.embedder
.jarvis_pace.json
.jarvis_chronos.json
.jarvis_rumination.json
.jarvis_canary.json
.jarvis_backup.json
.jarvis_history.json
.jarvis_evolution.json
.jarvis_skills_nightly.json
# A02 SQLite runtime store + its WAL sidecars. Operational state, never committed --
# it holds real conversation text.
.jarvis_runtime.db
.jarvis_runtime.db-wal
.jarvis_runtime.db-shm
.jarvis_runtime.db.goals.lock

# --- Code graph (graphify) --------------------------------------------------
# graph.json IS committed: it is what the code_graph tool reads, so tracking it
# means the tool works on a fresh clone and on a server without needing
# graphify installed there. Everything else in graphify-out/ is regenerable
# churn (a 1.4MB HTML rewritten on every rebuild, caches, dated snapshots).
graphify-out/*
!graphify-out/graph.json

# --- Local tooling & scratch ------------------------------------------------
.claude/
_tmp_*.py
scratchpad/

# --- OS noise --------------------------------------------------------------
Thumbs.db
.DS_Store

# JARVIS's own space. Untracked deliberately: the always-on cloud deployment is where
# he actually writes -- letters, the owner's portrait, research notes, ruminations --
# and tracking it made every deploy a potential overwrite of the live copy with an
# older committed one. The server's vault is now the single authority.
#
# NOTE: this replaces the vault half of DEPLOY.md's §9 cron backup, which can no longer
# commit anything. `python -m backend.tools.backup` still zips the vault into
# backups/<timestamp>/vault.zip, but that lives on the same disk -- keep an off-box copy.
jarvis-vault/

# Thinking-headroom benchmark output (scripts/bench_thinking.py) -- carries the
# real owner portrait and vault notes, never committed.
.jarvis_bench/
.jarvis_uploads/

# pytest-testmon: which code each test touched (rebuilt locally, never shared)
.testmondata*
