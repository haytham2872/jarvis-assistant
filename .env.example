# JARVIS settings. Copy this file to .env and fill in the REQUIRED section; everything else
# is optional and can be added later. docs/SETUP.md explains each integration.
# Optional settings are commented out: remove the "# " in front of one to set it. Leave a
# setting commented rather than empty: an empty value is not the same as unset (for example
# OPENROUTER_STANDARD_MODEL= would select no model at all). Never put a placeholder in a key:
# any non-empty value counts as configured.

# ============================================================================================
# REQUIRED
# ============================================================================================

# The models: DeepSeek V4.1 Flash through OpenRouter (one key for chat, background work,
# memory extraction and the turn classifier). Put a few dollars of credit on it; a day of
# normal use costs cents.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# How you talk to JARVIS on a server: a Discord bot in a DM. With the token set and the id
# empty, JARVIS logs the id of whoever messages the bot, so you can find yours (docs/SETUP.md).
# Discord Developer Portal, Bot tab ("Message Content Intent" on)
DISCORD_BOT_TOKEN=
# your numeric Discord user id; anyone else is ignored
DISCORD_ALLOWED_USER_ID=

# ============================================================================================
# YOU (recommended: the defaults work, but JARVIS reads better knowing these)
# ============================================================================================

# your name, as JARVIS uses it in prompts and messages (empty: "the user")
JARVIS_OWNER_NAME=
# he, she or they (default they)
JARVIS_OWNER_PRONOUNS=
# your IANA time zone, e.g. Europe/Paris or America/New_York (default UTC)
JARVIS_TIMEZONE=
# the currency the portfolio totals in, e.g. EUR, USD, GBP (default EUR; ECB rates)
JARVIS_BASE_CURRENCY=
# the scope stored memory facts are kept under; any fixed word (default user)
# JARVIS_USER_NAME=
# your address in the web reader's User-Agent (Wikimedia asks for one)
JARVIS_CONTACT_EMAIL=

# ============================================================================================
# OPTIONAL INTEGRATIONS (each one is off until its key is set)
# ============================================================================================

# Web search, page reading and cited research reports. Free by rate limit. Without it,
# search falls back to the local SearXNG container, then to keyless scrapers.
# https://agent.tinyfish.ai/api-keys
# TINYFISH_API_KEY=
# SEARXNG_URL=http://localhost:8088  # the SearXNG container started by docker compose

# Gmail and Google Calendar (OAuth; the first use opens a consent page, see docs/SETUP.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Notion: an Ideas and a Tasks database shared with an internal integration
# https://www.notion.so/my-integrations
# NOTION_API_KEY=
# NOTION_IDEAS_DB_ID=
# NOTION_TASKS_DB_ID=

# Spotify (playback needs Premium). PKCE, no secret: a client id from the Spotify dashboard
# SPOTIFY_CLIENT_ID=

# The phone app (mobile/, Expo). Unset: the /mobile routes do not exist.
# a long random string; the app pairs by QR (mobile/tools/pair_qr.mjs)
# MOBILE_TOKEN=
# Google Cloud Text-to-Speech (Chirp 3 HD) for spoken answers on the phone
# GOOGLE_TTS_API_KEY=
# default en-US-Chirp3-HD-Fenrir
# MOBILE_TTS_VOICE=
# voice for answers that are mostly French, default fr-FR-Chirp3-HD-Fenrir
# MOBILE_TTS_VOICE_FR=
# characters a month before the app falls back to the phone's own voice (default 900000)
# MOBILE_TTS_MONTHLY_CHARS=
# chirp or edge, to force one
# MOBILE_TTS_ENGINE=

# Goals: work that runs past one answer, in bounded background sessions
# JARVIS_GOALS=0                     # 1 turns them on
# GOAL_DEFAULT_BUDGET_USD=1.0        # a goal's budget unless you give one
# GOALS_DAILY_BUDGET_USD=3.0         # all goals together, per local day

# ============================================================================================
# DESK ONLY (Windows: microphone, speech and the Electron UI; a server ignores these)
# ============================================================================================

# primary desk voice; without it edge-tts, then local Kokoro
# ELEVENLABS_API_KEY=
# TTS_VOICE=en-US-GuyNeural
# TTS_RATE=+8%
# TTS_PITCH=-5Hz
# TTS_FALLBACK_VOICE=am_adam
# NO_TTS=0                           # 1 skips speech entirely

# ============================================================================================
# ADVANCED (the defaults are measured; change only with a reason)
# ============================================================================================

# default https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
# default deepseek/deepseek-v4.1-flash
# OPENROUTER_STANDARD_MODEL=
# default deepseek/deepseek-v4.1-flash
# OPENROUTER_THINKING_MODEL=
# thinking-tier effort, default high
# OPENROUTER_REASONING_EFFORT=
# preferred hosts, default Together,BaseTen,Novita (empty string: price-first, measured 12-25x slower)
# OPENROUTER_PROVIDER_ORDER=
# JARVIS_JEV=1                       # 0 turns off the turn classifier (keyword rules decide instead)
# default typesafe/jev-1.13; thresholds were measured on it
# JARVIS_JEV_MODEL=
# JARVIS_JEV_URL=
# JARVIS_RERANK=1                    # 0 turns off the recall cross-encoder
# must be in the local Hugging Face cache
# JARVIS_RERANK_MODEL=
# QDRANT_HOST=localhost
# JARVIS_HOST=127.0.0.1              # backend bind address. Keep loopback: the WebSocket has no login
# WS_PORT=8765                       # the port the terminal client (backend/cli.py) connects to
# JARVIS_SESSION_GAP_HOURS=2.0       # quiet hours before a new conversation starts
# ordered daily-close sources; blank: nasdaq,yahoo for US, yahoo for EU
# JARVIS_PORTFOLIO_SOURCES=
# STT_ENGINE=parakeet                # voice notes: parakeet (English + French) or whisper
# CPU threads for transcription (default: the machine's, up to 4)
# STT_THREADS=
# WHISPER_MODEL=small                # the fallback transcriber's model size
# HF_HUB_OFFLINE=1                   # 0 lets models download at startup; setup downloads them once
# the SQLite file, default .jarvis_runtime.db in the project
# JARVIS_DB_PATH=
# MEM0_TELEMETRY=False              # mem0's own usage analytics; off unless set to True
# 1 lets startup rebuild a memory collection an embedder change made unreadable (back up first)
# JARVIS_ALLOW_COLLECTION_DELETION=
